#!/usr/bin/env bash
# CachyOS Game Mode environment scrubber. A live greetd restart can preserve the
# previous desktop's user systemd manager briefly; Gamescope must not inherit its
# Wayland/display socket variables or it will try to launch as a nested session.
set -euo pipefail

stale_variables=(
    WAYLAND_DISPLAY
    DISPLAY
    XAUTHORITY
    NIRI_SOCKET
    SWAYSOCK
    HYPRLAND_INSTANCE_SIGNATURE
    OUTPUT_CONNECTOR
)

sessionctl="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/cachyos-sessionctl"
if ! prefer_output="$("$sessionctl" display prefer-output)"; then
    printf '%s\n' 'start-gamescope-session: display preference unavailable; using Gamescope defaults' >&2
    prefer_output=""
    prefer_mode=""
elif ! prefer_mode="$("$sessionctl" display prefer-mode)"; then
    printf '%s\n' 'start-gamescope-session: display preference unavailable; using Gamescope defaults' >&2
    prefer_mode=""
fi

install_output_mode_wrapper() {
    # The package start-gamescope-session execs `gamescope` from PATH with no -W/-H.
    local real_gamescope wrapper_dir
    real_gamescope="$(command -v gamescope)" || return 0
    wrapper_dir="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/cachyos-gamescope-mode.XXXXXX")"
    cat > "$wrapper_dir/gamescope" <<'EOF'
#!/bin/sh
exec "$CACHYOS_GAMESCOPE_BIN" -W "$CACHYOS_GAMESCOPE_W" -H "$CACHYOS_GAMESCOPE_H" -r "$CACHYOS_GAMESCOPE_R" "$@"
EOF
    chmod +x "$wrapper_dir/gamescope"
    export CACHYOS_GAMESCOPE_BIN="$real_gamescope"
    export PATH="$wrapper_dir:$PATH"
}

if [[ ${CACHYOS_GAMEMODE_TESTING:-0} != 1 ]]; then
    systemctl --user unset-environment "${stale_variables[@]}"
    if [[ -n $prefer_output ]]; then
        systemctl --user set-environment "OUTPUT_CONNECTOR=$prefer_output"
    fi
    start_command=/usr/bin/start-gamescope-session
else
    start_command="${CACHYOS_GAMEMODE_TEST_START:?test start command is required}"
fi

unset "${stale_variables[@]}"
if [[ -n $prefer_output ]]; then
    export OUTPUT_CONNECTOR="$prefer_output"
fi
if [[ $prefer_mode =~ ^([1-9][0-9]*)x([1-9][0-9]*)@([1-9][0-9]*)$ ]]; then
    export CACHYOS_GAMESCOPE_W="${BASH_REMATCH[1]}"
    export CACHYOS_GAMESCOPE_H="${BASH_REMATCH[2]}"
    export CACHYOS_GAMESCOPE_R="${BASH_REMATCH[3]}"
    install_output_mode_wrapper
    # Gamescope 3.16 calls init_drm(0,0,0); -W -H only size the nested
    # Steam desktop. The KMS mode for an external display comes from
    # GAMESCOPE_MODE_SAVE_FILE, which the CachyOS session already exports.
    if ! "$sessionctl" display apply-mode-save; then
        printf '%s\n' 'start-gamescope-session: could not write gamescope modes.cfg' >&2
    fi
fi
exec "$start_command" "$@"
