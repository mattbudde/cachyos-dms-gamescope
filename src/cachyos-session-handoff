#!/usr/bin/env python3
"""Privileged, deliberately narrow greetd live-session handoff helper."""

from __future__ import annotations

import argparse
import configparser
import os
import pwd
import stat
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path


CONFIG_PATH = Path("/etc/cachyos-gamemode.conf")


class HandoffError(RuntimeError):
    pass


@dataclass(frozen=True)
class Config:
    login_user: str
    runfile: Path
    greetd_service: str


def test_root() -> Path | None:
    # Test mode is intentionally unavailable to a privileged process.
    if os.geteuid() == 0 or os.environ.get("CACHYOS_GAMEMODE_TESTING") != "1":
        return None
    value = os.environ.get("CACHYOS_GAMEMODE_TEST_ROOT", "")
    return Path(value) if value else None


def rooted(path: Path) -> Path:
    root = test_root()
    if root is None:
        return path
    return root / path.relative_to("/")


def validate_live_config_file(path: Path) -> None:
    try:
        info = path.lstat()
    except OSError as exc:
        raise HandoffError(f"cannot inspect {path}: {exc}") from exc
    if not stat.S_ISREG(info.st_mode):
        raise HandoffError(f"{path} is not a regular file")
    if info.st_uid != 0 or info.st_mode & 0o022:
        raise HandoffError(f"{path} must be root-owned and not group/world-writable")


def read_config() -> Config:
    path = rooted(CONFIG_PATH)
    if test_root() is None:
        validate_live_config_file(path)
    parser = configparser.ConfigParser(interpolation=None)
    try:
        with path.open("r", encoding="utf-8") as handle:
            parser.read_file(handle)
        section = parser["session"]
        config = Config(
            login_user=section["login_user"].strip(),
            runfile=Path(section.get("greetd_runfile", "/run/greetd.run").strip()),
            greetd_service=section.get("greetd_service", "greetd.service").strip(),
        )
    except (OSError, KeyError, ValueError) as exc:
        raise HandoffError(f"cannot read valid configuration from {path}: {exc}") from exc

    if not config.login_user:
        raise HandoffError("configured login user is empty")
    if not config.runfile.is_absolute() or config.runfile.parent != Path("/run"):
        raise HandoffError(f"unsafe greetd runfile: {config.runfile}")
    if config.greetd_service != "greetd.service":
        raise HandoffError(f"unsupported display-manager service: {config.greetd_service}")
    return config


def require_privilege(config: Config) -> None:
    if test_root() is not None:
        return
    if os.geteuid() != 0:
        raise HandoffError("this helper must be invoked through pkexec")
    try:
        configured_uid = pwd.getpwnam(config.login_user).pw_uid
    except KeyError as exc:
        raise HandoffError(f"configured user {config.login_user!r} does not exist") from exc

    caller = os.environ.get("PKEXEC_UID") or os.environ.get("SUDO_UID")
    if caller is None:
        # Direct invocation by root is allowed for recovery/administration.
        return
    try:
        caller_uid = int(caller)
    except ValueError as exc:
        raise HandoffError("invalid caller uid") from exc
    if caller_uid != configured_uid:
        raise HandoffError("caller is not the configured session user")


def run_systemctl(arguments: list[str], *, check: bool = False) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(
        ["systemctl", *arguments],
        check=check,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def live_handoff(config: Config) -> None:
    runfile = rooted(config.runfile)
    if test_root() is not None:
        runfile.unlink(missing_ok=True)
        print(f"TEST: removed {runfile}; would restart {config.greetd_service}")
        return

    if run_systemctl(["is-active", "--quiet", config.greetd_service]).returncode != 0:
        raise HandoffError(f"{config.greetd_service} is not active")

    try:
        runfile.unlink(missing_ok=True)
    except OSError as exc:
        raise HandoffError(f"cannot re-arm greetd runfile {runfile}: {exc}") from exc

    result = run_systemctl(["--no-block", "restart", config.greetd_service])
    if result.returncode != 0:
        try:
            runfile.touch(mode=0o644, exist_ok=True)
        except OSError:
            pass
        raise HandoffError(f"could not queue restart of {config.greetd_service}")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Re-arm and restart greetd for a session handoff")
    parser.add_argument("target", choices=("gamescope", "desktop"))
    args = parser.parse_args(argv)
    try:
        config = read_config()
        require_privilege(config)
        live_handoff(config)
        print(f"Queued live handoff to {args.target}.")
        return 0
    except HandoffError as exc:
        print(f"cachyos-session-handoff: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
