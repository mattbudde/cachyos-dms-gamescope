)

Connector = NewType("Connector", str)
CheckStatus = Literal["ok", "warn", "fail"]
CONNECTOR_PATTERN = re.compile(r"[A-Za-z][A-Za-z0-9-]*-[0-9]+")
MODE_PATTERN = re.compile(r"([1-9]\d*)x([1-9]\d*)@([1-9]\d*)")
INTERNAL_PANEL_PREFIXES = ("eDP-", "LVDS-", "DSI-")
AUTO = "auto"
DISPLAY_FIELDS = {"gamescope": "gamescope_output", "desktop": "desktop_primary"}
DISPLAY_SET_TARGETS = (*DISPLAY_FIELDS, "mode")
NIRI_OUTPUTS_RETRY_SECONDS = 3.0
NIRI_OUTPUTS_RETRY_INTERVAL = 0.25
DOCTOR_COMMAND_TIMEOUT = 5.0


class SessionError(RuntimeError):
    pass


@dataclass(frozen=True)
class GamescopeMode:
    width: int
    height: int
    refresh: int

    def __str__(self) -> str:
        return f"{self.width}x{self.height}@{self.refresh}"


@dataclass(frozen=True)
class DisplayPreferences:
    gamescope_output: Connector | None = None
    desktop_primary: Connector | None = None
    gamescope_mode: GamescopeMode | None = None
    gamescope_make: str | None = None
    gamescope_model: str | None = None


@dataclass(frozen=True)
class Monitor:
    connector: Connector
    enabled: bool
    make: str | None
    model: str | None
    serial: str | None
    modes: tuple[GamescopeMode, ...] = ()

    @property
    def label(self) -> str:
        return self.model or self.make or self.connector


@dataclass(frozen=True)
class Check:
    id: str
    status: CheckStatus
    summary: str
    hint: str | None = None


@dataclass(frozen=True)
class Config:
    login_user: str
    desktop_session: str
    gamescope_session: str
    cache_dir: Path

    def session_id(self, target: str) -> str:
        if target == "gamescope":
            return self.gamescope_session
        if target == "desktop":
            return self.desktop_session
        raise SessionError(f"unsupported target: {target}")


def test_root() -> Path | None:
    if os.environ.get("CACHYOS_GAMEMODE_TESTING") != "1":
        return None
    value = os.environ.get("CACHYOS_GAMEMODE_TEST_ROOT", "")
    return Path(value) if value else None


def rooted(path: Path) -> Path:
    root = test_root()
    if root is None:
        return path
    return root / path.relative_to("/")


def config_path() -> Path:
    return rooted(CONFIG_PATH)


def read_config() -> Config:
    path = config_path()
    parser = configparser.ConfigParser(interpolation=None)
    try:
        with path.open("r", encoding="utf-8") as handle:
            parser.read_file(handle)
    except OSError as exc:
        raise SessionError(f"cannot read {path}: {exc}") from exc

    try:
        section = parser["session"]
        config = Config(
            login_user=section["login_user"].strip(),
            desktop_session=section["desktop_session"].strip(),
            gamescope_session=section["gamescope_session"].strip(),
            cache_dir=Path(section["dms_cache_dir"].strip()),
        )
    except (KeyError, ValueError) as exc:
        raise SessionError(f"invalid session configuration in {path}: {exc}") from exc

    for session_id in (config.desktop_session, config.gamescope_session):
        if not re.fullmatch(r"[A-Za-z0-9._+-]+\.desktop", session_id):
            raise SessionError(f"unsafe desktop session id in {path}: {session_id!r}")

    if not config.login_user or not config.cache_dir.is_absolute():
        raise SessionError(f"invalid user or cache directory in {path}")
    return config


def current_username() -> str:
    try:
        return pwd.getpwuid(os.getuid()).pw_name
    except KeyError as exc:
        raise SessionError(f"cannot resolve uid {os.getuid()}") from exc


def require_configured_user(config: Config) -> None:
    if test_root() is not None:
        return
    user = current_username()
    if user != config.login_user:
        raise SessionError(
            f"this integration is configured for {config.login_user!r}, not {user!r}"
        )


def memory_path(config: Config) -> Path:
    return rooted(config.cache_dir) / ".local/state/memory.json"


def read_memory(path: Path) -> tuple[dict[str, object], bytes | None]:
    try:
        original = path.read_bytes()
    except FileNotFoundError:
        return {}, None
    except OSError as exc:
        raise SessionError(f"cannot read DMS greeter memory {path}: {exc}") from exc

    try:
        value = json.loads(original.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise SessionError(f"invalid DMS greeter memory in {path}: {exc}") from exc
    if not isinstance(value, dict):
        raise SessionError(f"DMS greeter memory in {path} is not a JSON object")
    return value, original


def atomic_write(path: Path, payload: bytes) -> None:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        descriptor, temporary_name = tempfile.mkstemp(
            prefix=f".{path.name}.", dir=path.parent
        )
        temporary = Path(temporary_name)
        try:
            with os.fdopen(descriptor, "wb") as handle:
                handle.write(payload)
                handle.flush()
                os.fsync(handle.fileno())
            os.chmod(temporary, 0o664)
            os.replace(temporary, path)
        finally:
            temporary.unlink(missing_ok=True)
    except OSError as exc:
        raise SessionError(f"cannot write {path}: {exc}") from exc


def select_target(config: Config, target: str) -> tuple[Path, bytes | None]:
    path = memory_path(config)
    memory, original = read_memory(path)
    session_id = config.session_id(target)
    memory["lastSuccessfulUser"] = config.login_user
    memory["lastSessionId"] = f"/usr/share/wayland-sessions/{session_id}"
    memory["lastSessionDesktopId"] = session_id
    memory.pop("lastSessionExec", None)
    payload = (json.dumps(memory, indent=2, sort_keys=True) + "\n").encode("utf-8")
    atomic_write(path, payload)
    return path, original


def restore_memory(path: Path, original: bytes | None) -> None:
    if original is None:
        try:
            path.unlink(missing_ok=True)
        except OSError as exc:
            raise SessionError(f"cannot roll back DMS greeter memory: {exc}") from exc
    else:
        atomic_write(path, original)


def parse_connector(text: str) -> Connector:
    if not CONNECTOR_PATTERN.fullmatch(text):
        raise SessionError(f"not a DRM connector name: {text!r}")
    return Connector(text)


def parse_connector_or_auto(text: str) -> Connector | None:
    return None if text == AUTO else parse_connector(text)


def parse_gamescope_mode(text: str) -> GamescopeMode:
    match = MODE_PATTERN.fullmatch(text)
    if match is None:
        raise SessionError(f"not a Gamescope mode: {text!r}")
    return GamescopeMode(int(match[1]), int(match[2]), int(match[3]))


def parse_gamescope_mode_or_auto(text: str) -> GamescopeMode | None:
    return None if text == AUTO else parse_gamescope_mode(text)


def display_preferences_path() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config"
    return Path(base) / DISPLAY_PREFERENCES_RELATIVE


def read_display_preferences(path: Path) -> DisplayPreferences:
    parser = configparser.ConfigParser(interpolation=None)
    try:
        with path.open("r", encoding="utf-8") as handle:
            parser.read_file(handle)
    except FileNotFoundError:
        return DisplayPreferences()
    except (OSError, configparser.Error) as exc:
        raise SessionError(f"cannot read display preferences {path}: {exc}") from exc

    section = parser["display"] if parser.has_section("display") else {}
    values: dict[str, object] = {
        field: parse_connector(section[field].strip())
        for field in DISPLAY_FIELDS.values()
        if field in section
    }
    if "gamescope_mode" in section:
        values["gamescope_mode"] = parse_gamescope_mode(section["gamescope_mode"].strip())
    if "gamescope_make" in section:
        values["gamescope_make"] = parse_identity(section["gamescope_make"])
    if "gamescope_model" in section:
        values["gamescope_model"] = parse_identity(section["gamescope_model"])
    return DisplayPreferences(**values)


def parse_identity(text: str) -> str:
    value = text.strip()
    if not value or "\n" in value or ":" in value:
        raise SessionError(f"invalid display identity: {text!r}")
    return value


def write_display_preferences(path: Path, preferences: DisplayPreferences) -> None:
    lines = ["[display]"]
    for field in DISPLAY_FIELDS.values():
        value = getattr(preferences, field)
        if value is not None:
            lines.append(f"{field} = {value}")
    if preferences.gamescope_mode is not None:
        lines.append(f"gamescope_mode = {preferences.gamescope_mode}")
    if preferences.gamescope_make is not None:
        lines.append(f"gamescope_make = {preferences.gamescope_make}")
    if preferences.gamescope_model is not None:
        lines.append(f"gamescope_model = {preferences.gamescope_model}")
    atomic_write(path, ("\n".join(lines) + "\n").encode("utf-8"))


def gamescope_prefer_output(preferences: DisplayPreferences) -> str | None:
    if preferences.gamescope_output is None:
        return None
    return f"{preferences.gamescope_output},*"


def gamescope_prefer_mode(preferences: DisplayPreferences) -> str | None:
    mode = resolve_gamescope_kms_mode(preferences)
    if mode is None:
        return None
    return str(mode)


def pnp_id_for_make(make: str) -> str | None:
    path = rooted(PNP_IDS_PATH)
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None
    for line in text.splitlines():
        if not line or line.startswith("#") or "\t" not in line:
            continue
        pnp_id, name = line.split("\t", 1)
        if name.strip() == make:
            return pnp_id.strip()
    return None


def gamescope_sink_descriptions(preferences: DisplayPreferences) -> tuple[str, ...]:
    make = preferences.gamescope_make
    model = preferences.gamescope_model
    descriptions: list[str] = []
    if make and model:
        descriptions.append(f"{make} {model}")
        descriptions.append(f"{make} - {model}")
        pnp_id = pnp_id_for_make(make)
        if pnp_id:
            descriptions.append(f"{pnp_id} {model}")
            descriptions.append(f"{pnp_id} - {model}")
    elif model:
        descriptions.append(model)
    descriptions.append("External screen")
    seen: set[str] = set()
    unique: list[str] = []
    for description in descriptions:
        if description not in seen:
            seen.add(description)
            unique.append(description)
    return tuple(unique)


def gamescope_mode_save_path() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config"
    return Path(base) / GAMESCOPE_MODE_SAVE_RELATIVE


def niri_refresh_to_drm_hz(refresh_rate: object) -> int | None:
    if not isinstance(refresh_rate, int) or refresh_rate <= 0:
        return None
    hz = (refresh_rate + 500) // 1000 if refresh_rate >= 1000 else refresh_rate
    return hz if hz > 0 else None


def parse_niri_modes(output: dict[str, object]) -> tuple[GamescopeMode, ...]:
    raw = output.get("modes")
    if not isinstance(raw, list):
        return ()
    modes: list[GamescopeMode] = []
    seen: set[tuple[int, int, int]] = set()
    for item in raw:
        if not isinstance(item, dict):
            continue
        width = item.get("width")
        height = item.get("height")
        refresh = niri_refresh_to_drm_hz(item.get("refresh_rate"))
        if not isinstance(width, int) or not isinstance(height, int) or refresh is None:
            continue
        if width <= 0 or height <= 0:
            continue
        key = (width, height, refresh)
        if key in seen:
            continue
        seen.add(key)
        modes.append(GamescopeMode(width, height, refresh))
    return tuple(modes)


def resolve_gamescope_kms_mode(preferences: DisplayPreferences) -> GamescopeMode | None:
    pinned = preferences.gamescope_mode
    if pinned is None:
        return None
    monitor = find_monitor(
        niri_monitors_or_none() or (), preferences.gamescope_output
    )
    available = monitor.modes if monitor is not None else ()
    if not available:
        return pinned
    same_size = [
        mode
        for mode in available
        if mode.width == pinned.width and mode.height == pinned.height
    ]
    if same_size:
        exact = [mode for mode in same_size if mode.refresh == pinned.refresh]
        return exact[0] if exact else same_size[0]
    fallback = [
        mode for mode in available if mode.width == 1920 and mode.height == 1080
    ]
    if not fallback:
        return pinned
    sixty = [mode for mode in fallback if mode.refresh == 60]
    return sixty[0] if sixty else fallback[0]


def apply_gamescope_mode_save(preferences: DisplayPreferences) -> int:
    resolved = resolve_gamescope_kms_mode(preferences)
    if resolved is None:
        return 0
    if resolved != preferences.gamescope_mode:
        print(
            f"Gamescope mode {preferences.gamescope_mode} is not in the EDID; pinning {resolved}.",
            file=sys.stderr,
        )
        path = display_preferences_path()
        preferences = replace(preferences, gamescope_mode=resolved)
        write_display_preferences(path, preferences)
    path = gamescope_mode_save_path()
    descriptions = gamescope_sink_descriptions(preferences)
    prefixes = tuple(f"{description}:" for description in descriptions)
    existing: list[str] = []
    try:
        existing = [
            line
            for line in path.read_text(encoding="utf-8").splitlines()
            if line and not line.startswith(prefixes)
        ]
    except FileNotFoundError:
        pass
    except OSError as exc:
        raise SessionError(f"cannot read Gamescope mode save {path}: {exc}") from exc
    # Gamescope find_mode requires an exact DRM vrefresh. 59.94 Hz timings are
    # stored as 60; a missing size falls through to the EDID preferred 4K mode.
    # Refresh 0 skips that check and matches the first WxH mode.
    lines = existing + [
        f"{description}:{resolved.width}x{resolved.height}@0"
        for description in descriptions
    ]
    atomic_write(path, ("\n".join(lines) + "\n").encode("utf-8"))
    return 0


def default_primary(outputs: Sequence[Connector]) -> Connector | None:
    ordered = sorted(outputs)
    for output in ordered:
        if output.startswith(INTERNAL_PANEL_PREFIXES):
            return output
    return ordered[0] if ordered else None


def resolve_desktop_primary(
    preferences: DisplayPreferences, outputs: Sequence[Connector]
) -> Connector | None:
    if preferences.desktop_primary in outputs:
        return preferences.desktop_primary
    return default_primary(outputs)


def niri_session_active() -> bool:
    desktops = os.environ.get("XDG_CURRENT_DESKTOP", "").lower().split(":")
    return "niri" in desktops


def optional_text(value: object) -> str | None:
    return value if isinstance(value, str) else None


def parse_niri_outputs(reply: object) -> tuple[Monitor, ...]:
    if not isinstance(reply, dict):
        raise SessionError("niri outputs reply is not a JSON object")
    monitors = [
        Monitor(
            connector=parse_connector(name),
            enabled=output.get("logical") is not None,
            make=optional_text(output.get("make")),
            model=optional_text(output.get("model")),
            serial=optional_text(output.get("serial")),
            modes=parse_niri_modes(output),
        )
        for name, output in reply.items()
        if isinstance(output, dict)
    ]
    return tuple(sorted(monitors, key=lambda monitor: monitor.connector))


def niri_monitors() -> tuple[Monitor, ...]:
    niri = shutil.which("niri")
    if niri is None:
        raise SessionError("cannot query niri outputs: niri not found")
    root = test_root()
    if root is not None and not Path(niri).resolve().is_relative_to(root.resolve()):
        raise SessionError("cannot query niri outputs: live niri is hidden in tests")
    try:
        result = subprocess.run(
            [niri, "msg", "--json", "outputs"],
            check=False,
            capture_output=True,
            text=True,
        )
    except OSError as exc:
        raise SessionError(f"cannot query niri outputs: {exc}") from exc
    if result.returncode != 0:
        raise SessionError(f"niri msg outputs failed: {result.stderr.strip()}")
    try:
        reply = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise SessionError(f"invalid niri outputs reply: {exc}") from exc
    return parse_niri_outputs(reply)


def niri_monitors_or_none() -> tuple[Monitor, ...] | None:
    try:
        return niri_monitors()
    except SessionError:
        return None


def find_monitor(monitors: Sequence[Monitor], connector: Connector | None) -> Monitor | None:
    return next((monitor for monitor in monitors if monitor.connector == connector), None)


def monitor_report(
    monitors: Sequence[Monitor] | None, preferences: DisplayPreferences
) -> list[dict[str, object]] | None:
    if monitors is None:
        return None
    rows: list[dict[str, object]] = [
        {
            "connector": monitor.connector,
            "label": monitor.label,
            "enabled": monitor.enabled,
            "present": True,
        }
        for monitor in monitors
    ]
    pinned = preferences.gamescope_output
    if pinned is not None and find_monitor(monitors, pinned) is None:
        rows.append({"connector": pinned, "label": pinned, "enabled": False, "present": False})
    return rows


def monitor_roles(connector: object, preferences: DisplayPreferences) -> str:
    return ", ".join(
        target
        for target, field in DISPLAY_FIELDS.items()
        if getattr(preferences, field) == connector
    )


def desktop_state(row: dict[str, object]) -> str:
    if row["enabled"]:
        return "on"
    return "off" if row["present"] else "unplugged"


def niri_focus_monitor(connector: Connector) -> None:
    try:
        result = subprocess.run(
            ["niri", "msg", "action", "focus-monitor", connector], check=False
        )
    except OSError as exc:
        raise SessionError(f"cannot focus niri monitor: {exc}") from exc
    if result.returncode != 0:
        raise SessionError(f"niri focus-monitor {connector} failed with status {result.returncode}")


def niri_output_power(connector: Connector, enabled: bool) -> None:
    action = "on" if enabled else "off"
    try:
        result = subprocess.run(
            ["niri", "msg", "output", connector, action], check=False
        )
    except OSError as exc:
        raise SessionError(f"cannot set niri output {connector}: {exc}") from exc
    if result.returncode != 0:
        raise SessionError(
            f"niri output {connector} {action} failed with status {result.returncode}"
        )


def restore_desktop_display(preferences: DisplayPreferences) -> int:
    if not niri_session_active():
        print("Not a niri session; nothing to restore.")
        return 0
    deadline = time.monotonic() + NIRI_OUTPUTS_RETRY_SECONDS
    monitors = niri_monitors()
    while not monitors and time.monotonic() < deadline:
        time.sleep(NIRI_OUTPUTS_RETRY_INTERVAL)
        monitors = niri_monitors()
    connectors = tuple(monitor.connector for monitor in monitors)
    primary = resolve_desktop_primary(preferences, connectors)
    if primary is None:
        raise SessionError("niri reported no connected outputs")
    niri_output_power(primary, True)
    disabled = tuple(
        connector for connector in sorted(connectors) if connector != primary
    )
    for connector in disabled:
        niri_output_power(connector, False)
    niri_focus_monitor(primary)
    if disabled:
        print(f"Desktop on {primary}; disabled {', '.join(disabled)}.")
    else:
        print(f"Focused {primary}.")
    return 0


def display_list(preferences: DisplayPreferences) -> int:
    if not niri_session_active():
        print("Not a niri session; monitors can only be listed from the niri desktop.")
        return 0
    rows = monitor_report(niri_monitors(), preferences) or []
    lines = [("CONNECTOR", "DESKTOP", "MONITOR", "ROLE")] + [
        (
            str(row["connector"]),
            desktop_state(row),
            str(row["label"]),
            monitor_roles(row["connector"], preferences),
        )
        for row in rows
    ]
    widths = [max(len(line[column]) for line in lines) for column in range(len(lines[0]))]
    for line in lines:
        print("  ".join(cell.ljust(width) for cell, width in zip(line, widths)).rstrip())
    return 0


def remember_gamescope_identity(
    connector: Connector | None, current: DisplayPreferences
) -> tuple[str | None, str | None]:
    if connector is None:
        return None, None
    monitors = niri_monitors_or_none()
    if monitors:
        monitor = find_monitor(monitors, connector)
        if monitor is not None:
            return monitor.make, monitor.model
    if current.gamescope_output == connector:
        return current.gamescope_make, current.gamescope_model
    return None, None


def display_set(target: str, value: str) -> int:
    path = display_preferences_path()
    current = read_display_preferences(path)
    if target == "mode":
        preferences = replace(current, gamescope_mode=parse_gamescope_mode_or_auto(value))
    elif target == "gamescope":
        connector = parse_connector_or_auto(value)
        make, model = remember_gamescope_identity(connector, current)
        preferences = replace(
            current,
            gamescope_output=connector,
            gamescope_make=make,
            gamescope_model=model,
        )
    else:
        preferences = replace(current, **{DISPLAY_FIELDS[target]: parse_connector_or_auto(value)})
    write_display_preferences(path, preferences)
    print(f"Display preference for {target} set to {value}.")
    return 0


def display_command(args: argparse.Namespace) -> int:
    if args.display_command == "set":
        return display_set(args.target, args.value)
    preferences = read_display_preferences(display_preferences_path())
    if args.display_command == "prefer-output":
        prefer_output = gamescope_prefer_output(preferences)
        if prefer_output is not None:
            print(prefer_output)
        return 0
    if args.display_command == "prefer-mode":
        prefer_mode = gamescope_prefer_mode(preferences)
        if prefer_mode is not None:
            print(prefer_mode)
        return 0
    if args.display_command == "apply-mode-save":
        return apply_gamescope_mode_save(preferences)
    if args.display_command == "list":
        return display_list(preferences)
    return restore_desktop_display(preferences)


def confirm_switch(target: str) -> bool:
    destination = "Game Mode" if target == "gamescope" else "the desktop"
    message = (
        f"Switch to {destination} now?\n\n"
        "This ends the current graphical session. Save open work before continuing."
    )
    if shutil.which("kdialog"):
        return subprocess.run(
            [
                "kdialog",
                "--title",
                "CachyOS session handoff",
                "--warningyesno",
                message,
            ],
            check=False,
        ).returncode == 0
    if shutil.which("zenity"):
        return subprocess.run(
            ["zenity", "--question", "--title=CachyOS session handoff", f"--text={message}"],
            check=False,
        ).returncode == 0
    if sys.stdin.isatty():
        answer = input(f"{message}\nContinue? [y/N] ").strip().lower()
        return answer in {"y", "yes"}
    raise SessionError("confirmation requested, but no graphical dialog or terminal is available")


def handoff_command() -> list[str]:
    root = test_root()
    if root is not None:
        override = os.environ.get("CACHYOS_GAMEMODE_TEST_HANDOFF")
        if override:
            return [override]
        raise SessionError("test handoff path is not configured")
    return ["pkexec", str(HANDOFF_PATH)]


def perform_handoff(target: str) -> None:
    command = handoff_command() + [target]
    try:
        result = subprocess.run(command, check=False)
    except OSError as exc:
        raise SessionError(f"cannot run session handoff: {exc}") from exc
    if result.returncode != 0:
        raise SessionError(f"session handoff failed with status {result.returncode}")


def current_session() -> str:
    if os.environ.get("XDG_CURRENT_DESKTOP"):
        return os.environ["XDG_CURRENT_DESKTOP"]
    try:
        active = subprocess.run(
            ["systemctl", "--user", "is-active", "gamescope-session.target"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if active.returncode == 0:
            return "gamescope"
    except OSError:
        pass
    return "unknown"


def status(config: Config, compact: bool, as_json: bool) -> int:
    path = memory_path(config)
    memory, _ = read_memory(path)
    selected = str(memory.get("lastSessionDesktopId", "unset"))
    active = current_session()
    if compact:
        print(f"Active: {active}; next/remembered: {selected}")
        return 0

    preferences = read_display_preferences(display_preferences_path())
    prefer_output = gamescope_prefer_output(preferences)
    prefer_mode = gamescope_prefer_mode(preferences)
    if as_json:
        monitors = niri_monitors_or_none() if niri_session_active() else None
        report = {
            "active": active,
            "remembered": selected,
            "display": {
                "gamescope_output": preferences.gamescope_output,
                "gamescope_prefer_output": prefer_output,
                "gamescope_mode": prefer_mode,
                "desktop_primary": preferences.desktop_primary,
                "monitors": monitor_report(monitors, preferences),
            },
        }
        print(json.dumps(report, indent=2, sort_keys=True))
        return 0

    print(f"Configured user:   {config.login_user}")
    print(f"Desktop session:   {config.desktop_session}")
    print(f"Gamescope session: {config.gamescope_session}")
    print(f"Active session:     {active}")
    print(f"Remembered session: {selected}")
    print(f"DMS memory:         {path}")
    print(f"Gamescope output:   {preferences.gamescope_output or AUTO}"
          + (f" (OUTPUT_CONNECTOR={prefer_output})" if prefer_output else ""))
    print(f"Gamescope mode:     {preferences.gamescope_mode or AUTO}")
    print(f"Desktop primary:    {preferences.desktop_primary or AUTO}")
    return 0


def xdg_config_home() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME")
    return Path(base) if base else Path.home() / ".config"


def session_desktop_candidates(session_id: str) -> tuple[Path, ...]:
    data_home = os.environ.get("XDG_DATA_HOME")
    user_sessions = (
        Path(data_home) / "wayland-sessions"
        if data_home
        else Path.home() / ".local/share/wayland-sessions"
    )
    return (
        rooted(Path("/usr/share/wayland-sessions") / session_id),
        rooted(Path("/usr/local/share/wayland-sessions") / session_id),
        user_sessions / session_id,
    )


def find_session_desktop(session_id: str) -> Path | None:
    for path in session_desktop_candidates(session_id):
        if path.is_file():
            return path
    return None


def run_text(command: list[str]) -> subprocess.CompletedProcess[str] | None:
    try:
        return subprocess.run(
            command,
            check=False,
            capture_output=True,
            text=True,
            timeout=DOCTOR_COMMAND_TIMEOUT,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None


def try_read_config() -> tuple[Config | None, str | None]:
    try:
        config = read_config()
    except SessionError as exc:
        return None, str(exc)
    if test_root() is None:
        try:
            require_configured_user(config)
        except SessionError as exc:
            return config, str(exc)
    return config, None


def file_contains(path: Path, marker: str) -> bool:
    try:
        return marker in path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False


def check_marked_file(
    check_id: str,
    path: Path,
    marker: str,
    *,
    executable: bool,
) -> Check:
    live = rooted(path)
    if not live.is_file():
        return Check(check_id, "fail", f"{path} is missing")
    if executable and not os.access(live, os.X_OK):
        return Check(check_id, "fail", f"{path} is not executable")
    if not file_contains(live, marker):
        return Check(
            check_id,
            "fail",
            f"{path} is not the CachyOS Game Mode file",
            "re-run install.sh so it can replace an unrecognized file",
        )
    return Check(check_id, "ok", str(path))


def check_config(config: Config | None, error: str | None) -> Check:
    if error is not None:
        hint = None
        if config is not None:
            hint = f"run as {config.login_user}, not {current_username()}"
        return Check("config", "fail", error, hint)
    assert config is not None
    return Check(
        "config",
        "ok",
        f"{config_path()} ({config.login_user}, {config.desktop_session})",
    )


def check_config_perms() -> Check:
    path = config_path()
    try:
        info = path.lstat()
    except OSError as exc:
        return Check("config-perms", "fail", f"cannot inspect {path}: {exc}")
    if not stat.S_ISREG(info.st_mode):
        return Check("config-perms", "fail", f"{path} is not a regular file")
    if info.st_mode & 0o022:
        return Check(
            "config-perms",
            "fail",
            f"{path} must not be group/world-writable",
            "reinstall so install.sh can write a root-owned 0644 config",
        )
    if test_root() is None and info.st_uid != 0:
        return Check(
            "config-perms",
            "fail",
            f"{path} must be root-owned",
            "reinstall so install.sh can write a root-owned 0644 config",
        )
    return Check("config-perms", "ok", f"{path} is a regular, non-writable-by-others file")


def check_session_desktops(config: Config | None) -> Check:
    if config is None:
        return Check("session-desktops", "fail", "no session configuration to check")
    missing = [
        session_id
        for session_id in (config.desktop_session, config.gamescope_session)
        if find_session_desktop(session_id) is None
    ]
    if missing:
        return Check(
            "session-desktops",
            "fail",
            "missing " + ", ".join(missing),
            "install gamescope-session-cachyos and the configured desktop session",
        )
    return Check(
        "session-desktops",
        "ok",
        f"{config.desktop_session} and {config.gamescope_session} are installed",
    )


def check_shim() -> Check:
    marked = check_marked_file(
        "bin-shim",
        GAMESCOPE_SHIM_PATH,
        "CachyOS Game Mode environment scrubber",
        executable=True,
    )
    if marked.status != "ok":
        return marked
    expected = rooted(GAMESCOPE_SHIM_PATH).resolve()
    resolved = shutil.which("start-gamescope-session")
    if resolved is None:
        return Check(
            "bin-shim",
            "fail",
            "start-gamescope-session is not on PATH",
            "ensure /usr/local/bin is on PATH",
        )
    if Path(resolved).resolve() != expected:
        return Check(
            "bin-shim",
            "fail",
            f"start-gamescope-session resolves to {resolved}, not {expected}",
            "ensure /usr/local/bin precedes /usr/bin in PATH",
        )
    return Check("bin-shim", "ok", str(GAMESCOPE_SHIM_PATH))


def check_polkit() -> Check:
    path = rooted(POLKIT_PATH)
    if not path.is_file():
        return Check("polkit", "fail", f"{POLKIT_PATH} is missing")
    try:
        root = ElementTree.parse(path).getroot()
    except ElementTree.ParseError as exc:
        return Check("polkit", "fail", f"{POLKIT_PATH} is not valid XML: {exc}")
    action = root.find("action")
    if action is None or action.attrib.get("id") != POLKIT_ACTION:
        return Check(
            "polkit",
            "fail",
            f"{POLKIT_PATH} is missing {POLKIT_ACTION}",
        )
    annotate = action.find("annotate")
    exec_path = (annotate.text or "").strip() if annotate is not None else ""
    if exec_path != str(HANDOFF_PATH):
        return Check(
            "polkit",
            "fail",
            f"polkit exec.path is {exec_path!r}, expected {str(HANDOFF_PATH)!r}",
        )
    return Check("polkit", "ok", f"{POLKIT_PATH} allows the handoff helper")


def check_pkexec() -> Check:
    resolved = shutil.which("pkexec")
    if resolved is None:
        return Check("pkexec", "fail", "pkexec is not on PATH")
    return Check("pkexec", "ok", resolved)


def check_display_manager() -> Check | None:
    if test_root() is not None:
        return None
    result = run_text(["systemctl", "show", "-p", "Id", "--value", "display-manager"])
    if result is None:
        return Check("display-manager", "fail", "cannot query display-manager.service")
    identity = result.stdout.strip()
    if identity != "greetd.service":
        return Check(
            "display-manager",
            "fail",
            f"display-manager is {identity or 'unset'}, expected greetd.service",
        )
    active = run_text(["systemctl", "is-active", "--quiet", "greetd.service"])
    if active is None or active.returncode != 0:
        return Check("display-manager", "fail", "greetd.service is not active")
    return Check("display-manager", "ok", "greetd.service is the active display manager")


def check_memory(config: Config | None) -> Check:
    cache = config.cache_dir if config is not None else Path("/var/cache/dms-greeter")
    state_dir = rooted(cache) / ".local/state"
    path = state_dir / "memory.json"
    hint = "verify that this user belongs to the greeter group"
    if not state_dir.is_dir():
        return Check(
            "memory",
            "fail",
            f"{state_dir} is missing",
            hint,
        )
    if not os.access(state_dir, os.W_OK):
        return Check("memory", "fail", f"{state_dir} is not writable", hint)
    if not path.exists():
        return Check("memory", "ok", f"{path} is absent; the next set will create it")
    try:
        memory, _ = read_memory(path)
    except SessionError as exc:
        return Check("memory", "fail", str(exc))
    selected = memory.get("lastSessionDesktopId", "unset")
    return Check("memory", "ok", f"{path} (remembered {selected})")


def check_autologin() -> Check | None:
    if test_root() is not None:
        return None
    missing: list[str] = []
    queried = 0
    for setting in AUTOLOGIN_SETTINGS:
        result = run_text(["dms", "ipc", "call", "settings", "get", setting])
        if result is None or result.returncode != 0:
            continue
        queried += 1
        if result.stdout.strip() != "true":
            missing.append(setting)
    if queried == 0:
        return Check(
            "autologin",
            "warn",
            "could not query DMS greeter settings",
            "start a DMS session and re-run doctor",
        )
    if missing:
        return Check(
            "autologin",
            "fail",
            "disabled: " + ", ".join(missing),
            "re-run install.sh without --no-autologin",
        )
    return Check("autologin", "ok", "DMS greeter auto-login and remember-session are enabled")


def check_plugin_files() -> Check:
    path = xdg_config_home() / PLUGIN_RELATIVE
    if not path.is_file():
        return Check(
            "plugin-files",
            "fail",
            f"{path} is missing",
            "re-run install.sh without --no-plugin",
        )
    try:
        manifest = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        return Check("plugin-files", "fail", f"{path} is not valid JSON: {exc}")
    if not isinstance(manifest, dict) or manifest.get("id") != PLUGIN_ID:
        return Check("plugin-files", "fail", f"{path} is not the {PLUGIN_ID} plugin")
    return Check("plugin-files", "ok", str(path))


def check_plugin_enabled() -> Check | None:
    if test_root() is not None:
        return None
    result = run_text(["dms", "ipc", "call", "plugin-scan", "status", PLUGIN_ID])
    if result is None or result.returncode != 0:
        return Check(
            "plugin-enabled",
            "warn",
            "could not query DMS plugin status",
            "start a DMS session and re-run doctor",
        )
    status = result.stdout.split("\t", 1)[0].strip()
    if status != "loaded":
        return Check(
            "plugin-enabled",
            "warn",
            f"plugin status is {status or 'unknown'}",
            "enable cachyosGameMode in DMS plugins",
        )
    return Check("plugin-enabled", "ok", "cachyosGameMode is loaded")


def check_plugin_widget() -> Check | None:
    if test_root() is not None:
        return None
    result = run_text(["dms", "ipc", "call", "widget", "visibility", PLUGIN_ID])
    if result is None or result.returncode != 0:
        return Check(
            "plugin-widget",
            "warn",
            "could not query DankBar widget visibility",
            "add CachyOS Game Mode in Settings → Appearance → DankBar Layout",
        )
    visibility = result.stdout.strip()
    if visibility != "visible":
        return Check(
            "plugin-widget",
            "warn",
            f"widget visibility is {visibility or 'unknown'}",
            "add CachyOS Game Mode in Settings → Appearance → DankBar Layout",
        )
    return Check("plugin-widget", "ok", "DankBar widget is visible")


def check_autostart() -> Check:
    path = xdg_config_home() / AUTOSTART_RELATIVE
    if not niri_session_active():
        return Check("autostart", "ok", "not a niri session; restore autostart is unused")
    if not path.is_file():
        return Check(
            "autostart",
            "warn",
            f"{path} is missing",
            "re-run install.sh to restore the niri display autostart entry",
        )
    if not file_contains(path, AUTOSTART_EXEC_MARKER):
        return Check(
            "autostart",
            "warn",
            f"{path} is not the Game Mode restore entry",
        )
    return Check("autostart", "ok", str(path))


def check_gamescope_output(
    preferences: DisplayPreferences, monitors: Sequence[Monitor]
) -> Check:
    connector = preferences.gamescope_output
    if connector is None:
        return Check("gamescope-output", "ok", "auto")
    monitor = find_monitor(monitors, connector)
    if monitor is None:
        return Check(
            "gamescope-output",
            "warn",
            f"{connector} is not connected; Gamescope will fall back to any output",
            f"cachyos-sessionctl display set gamescope {AUTO}",
        )
    if monitor.enabled:
        return Check("gamescope-output", "ok", f"{connector} is connected")
    return Check(
        "gamescope-output",
        "ok",
        f"{connector} is connected (off on the desktop; Gamescope drives it directly)",
    )


def probe_gamescope_output() -> Check:
    try:
        preferences = read_display_preferences(display_preferences_path())
    except SessionError as exc:
        return Check("gamescope-output", "fail", str(exc))
    if preferences.gamescope_output is None:
        return check_gamescope_output(preferences, ())
    if not niri_session_active():
        return Check(
            "gamescope-output",
            "warn",
            f"{preferences.gamescope_output} is pinned; cannot verify it outside niri",
        )
    try:
        monitors = niri_monitors()
    except SessionError as exc:
        return Check("gamescope-output", "warn", f"cannot query niri outputs: {exc}")
    return check_gamescope_output(preferences, monitors)


def check_short_session() -> Check:
    path = xdg_config_home() / GUARD_RELATIVE
    if path.exists():
        return Check(
            "short-session",
            "warn",
            f"{path} is present",
            f"rm {path} after a few clean Game Mode round trips",
        )
    return Check("short-session", "ok", "short-session repair guard is not present")


def check_os() -> Check:
    path = rooted(OS_RELEASE_PATH)
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return Check("os", "warn", f"{OS_RELEASE_PATH} is missing")
    identity = ""
    for line in text.splitlines():
        if line.startswith("ID="):
            identity = line.partition("=")[2].strip().strip("\"'")
            break
    if identity != "cachyos":
        return Check("os", "warn", f"OS ID is {identity or 'unset'}, expected cachyos")
    return Check("os", "ok", "CachyOS")


def collect_doctor_checks() -> list[Check]:
    config, config_error = try_read_config()
    checks: list[Check] = [
        check_config(config, config_error),
        check_config_perms(),
        check_session_desktops(config),
        check_marked_file(
            "bin-sessionctl",
            SESSIONCTL_PATH,
            "cachyos-sessionctl:",
            executable=True,
        ),
        check_marked_file(
            "bin-handoff",
            HANDOFF_PATH,
            "cachyos-session-handoff:",
            executable=True,
        ),
        check_shim(),
        check_marked_file(
            "bin-steamos",
            STEAMOS_SELECT_PATH,
            "CachyOS Game Mode compatibility wrapper",
            executable=True,
        ),
        check_polkit(),
        check_pkexec(),
    ]
    for probe in (
        check_display_manager,
        lambda: check_memory(config),
        check_autologin,
        check_plugin_files,
        check_plugin_enabled,
        check_plugin_widget,
        check_autostart,
        probe_gamescope_output,
        check_short_session,
        check_os,
    ):
        result = probe()
        if result is not None:
            checks.append(result)
    return checks


def doctor_report(checks: list[Check]) -> dict[str, object]:
    fail = sum(1 for check in checks if check.status == "fail")
    warn = sum(1 for check in checks if check.status == "warn")
    return {
        "ok": fail == 0,
        "fail": fail,
        "warn": warn,
        "checks": [
            {
                "hint": check.hint,
                "id": check.id,
                "status": check.status,
                "summary": check.summary,
            }
            for check in checks
        ],
    }


def print_doctor_report(checks: list[Check]) -> None:
    width = max((len(check.id) for check in checks), default=0)
    for check in checks:
        print(f"{check.status:<5} {check.id:<{width}}  {check.summary}")
        if check.hint and check.status != "ok":
            print(f"      {'':<{width}}  {check.hint}")
    ok = sum(1 for check in checks if check.status == "ok")
    warn = sum(1 for check in checks if check.status == "warn")
    fail = sum(1 for check in checks if check.status == "fail")
    print()
    print(f"{ok} ok, {warn} warn, {fail} fail")


def doctor_command(as_json: bool) -> int:
    checks = collect_doctor_checks()
    if as_json:
        print(json.dumps(doctor_report(checks), indent=2, sort_keys=True))
    else:
        print_doctor_report(checks)
    return 1 if any(check.status == "fail" for check in checks) else 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Select or live-switch the DMS/greetd graphical session"
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    set_parser = subparsers.add_parser("set", help="select the next login session")
    set_parser.add_argument("target", choices=("gamescope", "desktop"))

    switch_parser = subparsers.add_parser("switch", help="switch sessions without rebooting")
    switch_parser.add_argument("target", choices=("gamescope", "desktop"))
    confirmation = switch_parser.add_mutually_exclusive_group()
    confirmation.add_argument("--confirm", action="store_true", help="show a confirmation dialog")
    confirmation.add_argument("--yes", action="store_true", help="skip confirmation")

    status_parser = subparsers.add_parser("status", help="show active and remembered sessions")
    status_format = status_parser.add_mutually_exclusive_group()
    status_format.add_argument("--compact", action="store_true")
    status_format.add_argument("--json", action="store_true", help="machine-readable report")

    doctor_parser = subparsers.add_parser(
        "doctor", help="check whether a live session switch can work"
    )
    doctor_parser.add_argument(
        "--json", action="store_true", help="machine-readable report"
    )

    display_parser = subparsers.add_parser("display", help="choose monitors per session")
    display_commands = display_parser.add_subparsers(dest="display_command", required=True)
    display_set_parser = display_commands.add_parser(
        "set", help="pick the Gamescope monitor, output mode, or the desktop primary"
    )
    display_set_parser.add_argument("target", choices=DISPLAY_SET_TARGETS)
    display_set_parser.add_argument("value", metavar="CONNECTOR|MODE|auto")
    display_commands.add_parser(
        "list", help="show connected monitors, on or off on the desktop"
    )
    display_commands.add_parser(
        "prefer-output", help="print the Gamescope OUTPUT_CONNECTOR value, if any"
    )
    display_commands.add_parser(
        "prefer-mode", help="print the Gamescope output mode, if any"
    )
    display_commands.add_parser(
        "apply-mode-save",
        help="write the pinned Gamescope DRM mode into gamescope's modes.cfg",
    )
    display_commands.add_parser(
        "restore-desktop",
        help="enable the desktop primary under niri and disable the other monitors",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        if args.command == "display":
            return display_command(args)
        if args.command == "doctor":
            return doctor_command(args.json)

        config = read_config()
        require_configured_user(config)

        if args.command == "status":
            return status(config, args.compact, args.json)

        if args.command == "switch" and not args.yes:
            if not args.confirm:
                raise SessionError("live switching requires --confirm or --yes")
            if not confirm_switch(args.target):
                print("Session switch cancelled.")
                return 0

        path, original = select_target(config, args.target)
        session_id = config.session_id(args.target)
        if args.command == "set":
            print(f"Remembered session set to {session_id}.")
            return 0

        try:
            perform_handoff(args.target)
        except SessionError:
            restore_memory(path, original)
            raise
        print(f"Switching to {session_id}.")
        return 0
    except SessionError as exc:
        print(f"cachyos-sessionctl: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
